{
  "name": "campusloop-backend",
  "version": "1.0.0",
  "description": "CampusLoop - Peer-to-peer campus rental platform backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix client",
    "predev": "node scripts/kill-ports.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "stripe:listen": ".\\stripe.exe listen --forward-to localhost:5000/api/webhooks/stripe",
    "stripe:trigger": ".\\stripe.exe trigger checkout.session.completed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "socket.io": "^4.7.5",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}
